@echo off
rem ---------------------------------------------------------------------------
rem AgentForge logon autostart: install / refresh / remove (current user).
rem
rem This launcher cannot live in the repo: it has to store an ABSOLUTE path to
rem the project, and that path differs on every machine. So it is generated
rem here, into the user's Startup folder - no admin rights, no registry writes,
rem no schtasks (schtasks.exe is blocked by some security policies).
rem
rem   install-autostart.bat            install or refresh
rem   install-autostart.bat /status    show whether it is installed
rem   install-autostart.bat /remove    uninstall
rem
rem KEEP THIS FILE ASCII-ONLY WITH CRLF LINE ENDINGS - same reason as
rem start-web.bat: cmd.exe tracks byte offsets by CRLF and decodes the file in
rem the console codepage, so a bare-LF file or non-ASCII text makes it run
rem half-sentences. The launcher written below is produced with echo, so it
rem lands in that very same codepage and stays safe even when the project path
rem contains CJK characters.
rem ---------------------------------------------------------------------------
setlocal EnableExtensions
cd /d "%~dp0"

set "NAME=AgentForge Web UI.bat"
set "AUTOSTART=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup"
set "LNK=%AUTOSTART%\%NAME%"
set "TARGET=%~dp0start-service.bat"
set "LOGPATH=%~dp0.run\service.log"

if /i "%~1"=="/remove" goto remove
if /i "%~1"=="remove"  goto remove
if /i "%~1"=="/status" goto status
if /i "%~1"=="status"  goto status

if not exist "%AUTOSTART%" (
  echo [AgentForge] Startup folder not found:
  echo   %AUTOSTART%
  exit /b 1
)
if not exist "%TARGET%" (
  echo [AgentForge] start-service.bat is missing next to this script.
  echo [AgentForge] Run this file from inside the project folder.
  exit /b 1
)

>"%LNK%"  echo @echo off
>>"%LNK%" echo rem AgentForge autostart: start the resident service at logon.
>>"%LNK%" echo rem It keeps http://127.0.0.1:8787 alive and brings it back if it drops.
>>"%LNK%" echo rem Generated by install-autostart.bat.
>>"%LNK%" echo rem Delete this file, or run install-autostart.bat /remove, to disable.
>>"%LNK%" echo rem Logs: %LOGPATH%
>>"%LNK%" echo call "%TARGET%"

echo [AgentForge] Autostart installed.
echo   launcher : %LNK%
echo   target   : %TARGET%
echo [AgentForge] Active from the next logon. To start it right now, double-click
echo [AgentForge] start-service.bat in the project folder.
exit /b 0

:status
if exist "%LNK%" (
  echo [AgentForge] Autostart is INSTALLED:
  echo   %LNK%
  echo.
  type "%LNK%"
) else (
  echo [AgentForge] Autostart is NOT installed.
  echo [AgentForge] Run install-autostart.bat to install it.
)
exit /b 0

:remove
if exist "%LNK%" (
  del "%LNK%"
  echo [AgentForge] Removed: %LNK%
) else (
  echo [AgentForge] Nothing to remove - autostart was not installed.
)
echo [AgentForge] The running service is left untouched.
echo [AgentForge] Stop it with: .venv\Scripts\python.exe service.py --stop
exit /b 0
