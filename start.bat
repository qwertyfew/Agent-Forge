@echo off
rem ===========================================================================
rem AgentForge - the ONE file to double-click on Windows.
rem
rem It does three things, and all three are idempotent (re-running is safe):
rem   1. creates .venv and installs dependencies on a fresh clone;
rem   2. registers the logon autostart entry, so the service also comes back
rem      by itself after a reboot;
rem   3. starts the resident service - WINDOWLESS (pythonw), so nothing lands
rem      in the taskbar and there is no console window to accidentally close.
rem
rem Options (from a terminal, not needed for normal use):
rem   start.bat --status             show what is running
rem   start.bat --stop               stop the resident + web service
rem   start.bat --no-autostart       do not touch the autostart entry
rem   start.bat --remove-autostart   remove the autostart entry
rem
rem KEEP THIS FILE ASCII-ONLY WITH CRLF LINE ENDINGS. cmd.exe tracks byte
rem offsets by CRLF and decodes the file in the console codepage, so a bare-LF
rem file, or non-ASCII text on a 936 (GBK) console, makes it run half-sentences
rem as commands and die. See docs/BATCH_D_REPORT.md section 6.
rem ===========================================================================
setlocal EnableExtensions
cd /d "%~dp0"

set "PYW=.venv\Scripts\pythonw.exe"
set "PY=.venv\Scripts\python.exe"
set "STARTUP=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup"
set "LNK=%STARTUP%\AgentForge Web UI.bat"

set "MODE=start"
set "AUTOSTART=yes"

:parse
if "%~1"=="" goto parsed
if /i "%~1"=="--status"            set "MODE=status"
if /i "%~1"=="/status"            set "MODE=status"
if /i "%~1"=="--stop"              set "MODE=stop"
if /i "%~1"=="/stop"              set "MODE=stop"
if /i "%~1"=="--remove-autostart"  set "MODE=remove-autostart"
if /i "%~1"=="--no-autostart"      set "AUTOSTART=no"
if /i "%~1"=="--help"              goto usage
if /i "%~1"=="-h"                  goto usage
shift
goto parse
:parsed

if "%MODE%"=="remove-autostart" goto do_remove_autostart
if "%MODE%"=="status" goto do_status
if "%MODE%"=="stop"   goto do_stop

rem --- 1) virtualenv ---------------------------------------------------------
if exist "%PY%" goto have_venv
echo [AgentForge] First run: creating .venv and installing dependencies...
python -m venv .venv
if errorlevel 1 (
  echo [AgentForge] Could not create .venv. Install Python 3.10+, make sure
  echo [AgentForge] "python" is on PATH, then run this file again.
  pause
  exit /b 1
)
"%PY%" -m pip install --upgrade pip -q
"%PY%" -m pip install -r requirements.txt -q
if errorlevel 1 (
  echo [AgentForge] Dependency install failed. Check your network and retry.
  pause
  exit /b 1
)

:have_venv
if not exist .run mkdir .run

rem --- 2) autostart ----------------------------------------------------------
if /i "%AUTOSTART%"=="no" goto after_autostart
call :install_autostart
:after_autostart

rem --- 3) resident service, windowless ---------------------------------------
rem No pre-check needed: service.py is its own guard. If the babysitter is
rem already running, this new process just reports it and exits.
start "" "%PYW%" service.py
echo.
echo [AgentForge] Done. Web UI: http://127.0.0.1:8787
echo [AgentForge] A hidden background service keeps it alive: nothing in the
echo [AgentForge] taskbar, no window to close, and it returns after a reboot.
echo [AgentForge]   status : start.bat --status
echo [AgentForge]   stop   : start.bat --stop
echo [AgentForge]   logs   : .run\service.log
goto :eof

:do_status
if not exist "%PY%" echo [AgentForge] Not set up yet - run start.bat once with no options.
if exist "%PY%" "%PY%" service.py --status
goto :eof

:do_stop
if not exist "%PY%" echo [AgentForge] Not set up yet - there is nothing to stop.
if exist "%PY%" "%PY%" service.py --stop
goto :eof

:do_remove_autostart
if exist "%LNK%" (
  del "%LNK%"
  echo [AgentForge] Autostart removed: %LNK%
) else (
  echo [AgentForge] Autostart was not installed.
)
echo [AgentForge] A running service is untouched. Stop it with: start.bat --stop
goto :eof

:install_autostart
if not exist "%STARTUP%" goto :eof
>"%LNK%"  echo @echo off
>>"%LNK%" echo rem AgentForge logon launcher. Generated by start.bat - do not edit.
>>"%LNK%" echo rem Starts the hidden resident service that keeps 127.0.0.1:8787 up.
>>"%LNK%" echo rem Disable: delete this file, or run  start.bat --remove-autostart
>>"%LNK%" echo cd /d "%~dp0"
>>"%LNK%" echo start "" ".venv\Scripts\pythonw.exe" service.py
goto :eof

:usage
echo AgentForge launcher. Double-click it, or use:
echo   start.bat                    set up + start (default)
echo   start.bat --status           show what is running
echo   start.bat --stop             stop the resident + web service
echo   start.bat --no-autostart     do not touch the autostart entry
echo   start.bat --remove-autostart remove the autostart entry
goto :eof
