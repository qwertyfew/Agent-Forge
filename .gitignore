# Python
__pycache__/
*.py[cod]
*.egg-info/

# 本项目
.venv/
.sessions/
.run/

# 本机专属配置：工作区绝对路径、模型窗口、步数上限这些换台机器就不成立，
# 所以不入库。通用模板是 config.yaml（入库），照它复制一份改成本机值即可。
config.lanrun.yaml
config.local.yaml

# 开发期诊断脚本与验证截图（本地用，不入库）
tools/shots*/
tools/*_probe.py
_tmp/
*.log

# 编辑器
.vscode/
.idea/

# 模型状态文件一律只留本机，不入库：
# models.json 里存着在线模型的 API Key，入库等于把密钥写进 git 历史（改不掉，只能重写历史）。
# 通用模板是 models.example.json（已入库），照它复制一份 models.json 再填 key。
# models.local.json 是本地模型的自动探测结果（每台机器装了哪些模型、显存多大都不同）。
models.json
models.local.json

# 任务历史与运行状态（每次运行都在变，不入库）
.tasks.json
.prefs.json
.tmp_research/
.tmp_models_test.json

# 任务产出目录（orchestrator 按发起时间生成，统一收在 history/ 下）与员工自建临时目录
history/
debug/
temp/

# 工作区运行期状态：任务笔记、上传附件每次运行都在变，不入库。
# 例外：长期记忆 memory.md 只有几百字节且跨机器通用，随仓库同步。
.agentforge/*
!.agentforge/memory.md

# 评测运行产物：沙盒（.run，每条任务的真实工作文件）与跑批结果（results）都不入库；
# 入库的是任务定义 tasks.yaml 与判定器 evals.py
evals/.run/
evals/results/

# 容器化部署的本地数据卷与密钥环境文件（不入库）
data/
.env

# 第三方接入项目目录（各含自己的 .git，是嵌套仓库，不入本仓库库）
external/
