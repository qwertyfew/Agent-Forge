# Python
__pycache__/
*.py[cod]
*.egg-info/

# 本项目
.venv/
.sessions/
.run/

# 本机专属配置：工作区绝对路径、模型窗口、步数上限这些换台机器就不成立，
# 所以不入库。通用模板是 config.yaml（入库），照它复制一份改成本机值即可。
config.lanrun.yaml
config.local.yaml

# 开发期诊断脚本与验证截图（本地用，不入库）
tools/shots*/
tools/*_probe.py
_tmp/
*.log

# 编辑器
.vscode/
.idea/

# 模型状态文件一律只留本机，不入库：
# models.json 里存着在线模型的 API Key，入库等于把密钥写进 git 历史（改不掉，只能重写历史）。
# 通用模板是 models.example.json（已入库），照它复制一份 models.json 再填 key。
# models.local.json 是本地模型的自动探测结果（每台机器装了哪些模型、显存多大都不同）。
models.json
models.local.json

# 任务历史与运行状态（每次运行都在变，不入库）
.tasks.json
.prefs.json
.tmp_research/
.tmp_models_test.json

# 工作区记忆（随任务增长，每台机器不同）
.agentforge/
