# 复制为 .env 后按需修改（compose 会自动读取）。
# 都有默认值，不建这个文件也能跑。

# Ollama 上游地址：
#   默认 http://ollama:11434 —— 配合 compose 里 --profile ollama 的容器
#   用云服务器外部已有的 Ollama 时改成它的地址，例如 http://1.2.3.4:11434
#   只用 models.json 里的在线模型（不要 Ollama）时随便填一个不可达地址即可，
#   界面会显示「Ollama 无响应」，在线模型照常可用
AGENTFORGE_OLLAMA_HOST=http://ollama:11434

# 是否允许程序自己拉起 Ollama（容器里没有 Ollama 可执行文件，保持 false）
AGENTFORGE_OLLAMA_AUTO_START=false

# Web 界面对外端口
AGENTFORGE_PORT=8787
